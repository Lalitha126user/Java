import java.util.Scanner;
public class multiply{
    public static void main(String[] args){
        Scanner scn = new Scanner(System.in);
        System.out.println("Enter a number: ");
        int num = next.Int();
        int i;
        for(i=1;i<=10;i++){
            int mul = num*i;
            System.out.println(mul);
        }
        scn.close();
    }
}